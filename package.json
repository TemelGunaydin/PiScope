    "check": "node scripts/check.mjs",
    "install:pi": "node scripts/install-pi.mjs",
    "open": "node scripts/open.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions/agent-dashboard/index.ts"
    ]
  },
