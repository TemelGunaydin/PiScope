{
  "name": "agent-workflow-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first, model-independent Pi workflow observability.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
